{
  "name": "wom-hiscores",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "npm run config && ng build",
    "config": "ts-node src/environments/set-env.ts",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build-pages": "ng build --base-href https://zemachin.github.io/wom-hiscores/ && mv dist/wom-hiscores/browser/* dist/wom-hiscores/ && rmdir dist/wom-hiscores/browser",
    "deploy-pages": "npx angular-cli-ghpages --dir=dist/wom-hiscores"
  },
  "private": true,
  "packageManager": "npm@12.0.1",
  "dependencies": {
    "@angular/common": "^22.0.8",
    "@angular/compiler": "^22.0.8",
    "@angular/core": "^22.0.8",
    "@angular/forms": "^22.0.8",
    "@angular/platform-browser": "^22.0.8",
    "@angular/router": "^22.0.8",
    "@primeuix/themes": "^3.0.0",
    "@wise-old-man/utils": "^4.0.20",
    "angular-cli-ghpages": "^3.1.0",
    "colors": "^1.4.0",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "localstorage-polyfill": "^1.0.1",
    "npm-check-updates": "^23.0.0",
    "primeng": "^22.0.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular/build": "^22.0.8",
    "@angular/cli": "^22.0.8",
    "@angular/compiler-cli": "^22.0.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.2",
    "jsdom": "^30.0.0",
    "postcss": "^8.5.23",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}
